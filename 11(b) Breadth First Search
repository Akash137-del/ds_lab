{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyM4Z0rmBt2cPPUWNmANeEZu"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"jaawegznSiNA"},"outputs":[],"source":["# EXPERIMENT 11(b)\n","# Breadth First Search\n","\n","from collections import defaultdict\n","\n","\n","class Graph:\n","\n","    def __init__(self):\n","        self.graph = defaultdict(list)\n","\n","    def addEdge(self, u, v):\n","        self.graph[u].append(v)\n","\n","    def BFS(self, start):\n","\n","        visited = [False] * len(self.graph)\n","\n","        queue = []\n","\n","        queue.append(start)\n","\n","        visited[start] = True\n","\n","        while queue:\n","\n","            vertex = queue.pop(0)\n","\n","            print(vertex, end=\" \")\n","\n","            for i in self.graph[vertex]:\n","\n","                if not visited[i]:\n","\n","                    queue.append(i)\n","\n","                    visited[i] = True\n","\n","\n","# Create graph\n","g = Graph()\n","\n","g.addEdge(0, 1)\n","g.addEdge(0, 2)\n","g.addEdge(1, 2)\n","g.addEdge(2, 0)\n","g.addEdge(2, 3)\n","g.addEdge(3, 3)\n","\n","print(\"Following is BFS from vertex 2:\")\n","g.BFS(2)"]}]}