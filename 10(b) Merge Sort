{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOj+KuC16lO4wLMV7uDtjYx"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"CRcvnwqESNzb"},"outputs":[],"source":["# EXPERIMENT 10(b)\n","# Merge Sort\n","\n","def merge_sort(arr):\n","\n","    if len(arr) > 1:\n","\n","        mid = len(arr) // 2\n","\n","        left = arr[:mid]\n","        right = arr[mid:]\n","\n","        merge_sort(left)\n","        merge_sort(right)\n","\n","        i = 0\n","        j = 0\n","        k = 0\n","\n","        # Merge two sorted arrays\n","        while i < len(left) and j < len(right):\n","\n","            if left[i] < right[j]:\n","\n","                arr[k] = left[i]\n","                i += 1\n","\n","            else:\n","\n","                arr[k] = right[j]\n","                j += 1\n","\n","            k += 1\n","\n","        # Remaining elements of left\n","        while i < len(left):\n","\n","            arr[k] = left[i]\n","            i += 1\n","            k += 1\n","\n","        # Remaining elements of right\n","        while j < len(right):\n","\n","            arr[k] = right[j]\n","            j += 1\n","            k += 1\n","\n","\n","arr = [12, 11, 13, 5, 6, 7]\n","\n","print(\"Given array:\", arr)\n","\n","merge_sort(arr)\n","\n","print(\"Sorted array:\", arr)"]}]}